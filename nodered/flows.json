        "func": "if (msg.req.headers['x-api-key'] !== 'rahasia-iot-123') {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'Unauthorized'};\n    return msg;\n}\nvar batas = parseFloat(msg.payload.threshold);\nflow.set('suhuThreshold', batas);\nmsg.payload = {status: 'success', threshold: batas};\nreturn msg;",
