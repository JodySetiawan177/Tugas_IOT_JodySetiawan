    {
        "id": "fn_sensor",
        "type": "function",
        "z": "tab_iot_final",
        "name": "Simpan SQLite & WS",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nvar threshold = flow.get('suhuThreshold') || 30.0;\nvar isAlert = data.suhu > threshold;\n\nvar sqlMsg = {\n    topic: `INSERT INTO sensor_logs (suhu, kelembaban, timestamp) VALUES (${data.suhu}, ${data.kelembaban}, '${data.received}')`\n};\n\nvar wsMsg = {\n    payload: JSON.stringify({\n        type: 'sensor_update',\n        data: data,\n        threshold: threshold,\n        alert: isAlert,\n        alert_msg: isAlert ? `PERINGATAN! Suhu (${data.suhu}°C) melewati batas (${threshold}°C)!` : null\n    })\n};\n\nreturn [sqlMsg, wsMsg];",
        "outputs": 2,
        "x": 350,
        "y": 140,
        "wires": [
            [
                "sql_insert"
            ],
            [
                "ws_out"
            ]
        ]
    },
