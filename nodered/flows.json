    {
        "id": "tpl_dash",
        "type": "template",
        "z": "tab_iot_final",
        "name": "HTML Dashboard",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "plain",
        "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>IoT Dashboard - REST API & WebSocket</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }\n        body { background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; padding: 20px; color: #333; }\n        .container { max-width: 1000px; margin: 0 auto; }\n        h1 { color: white; text-align: center; margin-bottom: 20px; font-size: 26px; }\n        .alert-banner { display: none; background: #dc3545; color: white; padding: 15px; border-radius: 10px; margin-bottom: 20px; font-weight: bold; text-align: center; }\n        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 20px; }\n        .card { background: white; border-radius: 15px; padding: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); text-align: center; }\n        .card .label { font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 1px; }\n        .card .value { font-size: 40px; font-weight: bold; margin: 8px 0; color: #667eea; }\n        .status-badge { display: inline-block; padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: bold; }\n        .status-online { background: #d4edda; color: #155724; }\n        .status-offline { background: #f8d7da; color: #721c24; }\n        .panel { background: white; border-radius: 15px; padding: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); margin-bottom: 20px; }\n        .panel h2 { font-size: 17px; margin-bottom: 15px; color: #444; }\n        .controls { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }\n        input { padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; width: 140px; }\n        .btn { padding: 10px 22px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; color: white; }\n        .btn-on { background: #28a745; }\n        .btn-off { background: #dc3545; }\n        .btn-primary { background: #667eea; }\n        table { width: 100%; border-collapse: collapse; }\n        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }\n        #log { background: #1e1e1e; color: #0f0; font-family: monospace; padding: 12px; border-radius: 8px; max-height: 150px; overflow-y: auto; font-size: 12px; }\n        .error { color: #ff6b6b; }\n    </style>\n</head>\n<body>\n<div class=\"container\">\n    <h1>IoT Dashboard — REST API, WebSocket & SQLite</h1>\n    <div id=\"alert-box\" class=\"alert-banner\"></div>\n    <div class=\"cards\">\n        <div class=\"card\">\n            <div class=\"label\">Suhu Ruangan</div>\n            <div class=\"value\" id=\"suhu\">--</div>\n            <div>°C (Batas: <span id=\"current-threshold\">30</span>°C)</div>\n        </div>\n        <div class=\"card\">\n            <div class=\"label\">Kelembaban</div>\n            <div class=\"value\" id=\"kelembaban\">--</div>\n            <div>%</div>\n        </div>\n        <div class=\"card\">\n            <div class=\"label\">Koneksi WebSocket</div>\n            <div class=\"value\" style=\"font-size:20px; margin-top: 20px;\">\n                <span class=\"status-badge status-offline\" id=\"ws-badge\">DISCONNECTED</span>\n            </div>\n        </div>\n    </div>\n    <div class=\"panel\">\n        <h2>Grafik Monitoring Suhu & Kelembaban (Real-Time)</h2>\n        <canvas id=\"sensorChart\" height=\"90\"></canvas>\n    </div>\n    <div class=\"panel\">\n        <h2>Kontrol Aktuator & Batas Suhu (Threshold)</h2>\n        <div class=\"controls\">\n            <button class=\"btn btn-on\" onclick=\"kontrol('lamp','on')\">Nyalakan Lampu</button>\n            <button class=\"btn btn-off\" onclick=\"kontrol('lamp','off')\">Matikan Lampu</button>\n            <span style=\"margin-left:auto;\"></span>\n            <input type=\"number\" id=\"input-threshold\" placeholder=\"Batas (°C)\" step=\"0.5\" value=\"30\">\n            <button class=\"btn btn-primary\" onclick=\"setThreshold()\">Set Threshold (PUT)</button>\n        </div>\n    </div>\n    <div class=\"panel\">\n        <h2>History Data Sensor (Database SQLite)</h2>\n        <table>\n            <thead><tr><th>Waktu</th><th>Suhu (°C)</th><th>Kelembaban (%)</th></tr></thead>\n            <tbody id=\"history-body\"><tr><td colspan=\"3\">Memuat data...</td></tr></tbody>\n        </table>\n    </div>\n    <div class=\"panel\">\n        <h2>Log Aktivitas</h2>\n        <div id=\"log\"></div>\n    </div>\n</div>\n<script>\nconst API_BASE = '/api';\nconst WS_URL = 'ws://' + location.host + '/ws/sensor';\nconst API_KEY = 'rahasia-iot-123';\nconst authHeaders = { 'Content-Type': 'application/json', 'X-API-Key': API_KEY };\n\nfunction log(msg, isError = false) {\n    const el = document.getElementById('log');\n    el.innerHTML += `<div class=\"${isError ? 'error' : ''}\">[${new Date().toLocaleTimeString()}] ${msg}</div>`;\n    el.scrollTop = el.scrollHeight;\n}\n\nconst ctx = document.getElementById('sensorChart').getContext('2d');\nconst sensorChart = new Chart(ctx, {\n    type: 'line',\n    data: {\n        labels: [],\n        datasets: [\n            { label: 'Suhu (°C)', data: [], borderColor: '#dc3545', tension: 0.3, fill: false },\n            { label: 'Kelembaban (%)', data: [], borderColor: '#667eea', tension: 0.3, fill: false }\n        ]\n    },\n    options: { responsive: true }\n});\n\nfunction updateChart(timeLabel, suhu, kelembaban) {\n    if (sensorChart.data.labels.length > 15) {\n        sensorChart.data.labels.shift();\n        sensorChart.data.datasets[0].data.shift();\n        sensorChart.data.datasets[1].data.shift();\n    }\n    sensorChart.data.labels.push(timeLabel);\n    sensorChart.data.datasets[0].data.push(suhu);\n    sensorChart.data.datasets[1].data.push(kelembaban);\n    sensorChart.update();\n}\n\nfunction connectWebSocket() {\n    const ws = new WebSocket(WS_URL);\n    const badge = document.getElementById('ws-badge');\n    ws.onopen = () => {\n        badge.textContent = 'CONNECTED (WS)';\n        badge.className = 'status-badge status-online';\n        log('WebSocket terhubung ke Node-RED.');\n    };\n    ws.onmessage = (event) => {\n        const msg = JSON.parse(event.data);\n        if (msg.type === 'sensor_update') {\n            const d = msg.data;\n            document.getElementById('suhu').textContent = d.suhu;\n            document.getElementById('kelembaban').textContent = d.kelembaban;\n            document.getElementById('current-threshold').textContent = msg.threshold;\n            const alertBox = document.getElementById('alert-box');\n            if (msg.alert) {\n                alertBox.style.display = 'block';\n                alertBox.textContent = msg.alert_msg;\n                log(msg.alert_msg, true);\n            } else {\n                alertBox.style.display = 'none';\n            }\n            updateChart(new Date(d.received).toLocaleTimeString(), d.suhu, d.kelembaban);\n            fetchHistory();\n        }\n    };\n    ws.onclose = () => {\n        badge.textContent = 'DISCONNECTED';\n        badge.className = 'status-badge status-offline';\n        setTimeout(connectWebSocket, 3000);\n    };\n}\n\nasync function fetchHistory() {\n    try {\n        const res = await fetch(`${API_BASE}/history`, { headers: authHeaders });\n        const json = await res.json();\n        const tbody = document.getElementById('history-body');\n        if (!json.data || json.data.length === 0) return;\n        tbody.innerHTML = json.data.slice(0, 10).map(d => `\n            <tr><td>${new Date(d.timestamp).toLocaleTimeString()}</td><td>${d.suhu}</td><td>${d.kelembaban}</td></tr>\n        `).join('');\n    } catch (err) {\n        log(`Gagal memuat history: ${err.message}`, true);\n    }\n}\n\nasync function kontrol(device, action) {\n    const res = await fetch(`${API_BASE}/kontrol`, { method: 'POST', headers: authHeaders, body: JSON.stringify({ device, action }) });\n    const json = await res.json();\n    log(json.status === 'success' ? `Perintah terkirim: ${device} -> ${action}` : json.message, json.status !== 'success');\n}\n\nasync function setThreshold() {\n    const val = document.getElementById('input-threshold').value;\n    const res = await fetch(`${API_BASE}/threshold`, { method: 'PUT', headers: authHeaders, body: JSON.stringify({ threshold: parseFloat(val) }) });\n    const json = await res.json();\n    if (json.status === 'success') {\n        document.getElementById('current-threshold').textContent = json.threshold;\n        log(`Threshold suhu diperbarui menjadi ${json.threshold}°C`);\n    }\n}\n\nfetchHistory();\nconnectWebSocket();\n</script>\n</body>\n</html>",
        "x": 350,
        "y": 520,
        "wires": [
            [
                "http_out"
            ]
        ]
    },
